# ---- Base de datos ----
# PostgreSQL en Supabase (ver docs/SUPABASE.md). Hacen falta las dos:
# la agrupada para la aplicacion y la directa para las migraciones.
DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...pooler.supabase.com:5432/postgres"

# ---- Moneda ----
MONEDA="CRC"

# ---- Operacion ----
# Hora a la que empieza el dia operativo. La pizzeria cierra de madrugada, asi
# que un pedido de la una de la manana pertenece a la noche anterior.
HORA_CORTE_DIA_OPERATIVO="06:00"

# ---- Respaldos ----
# Carpeta donde se guardan las copias. Ponga aqui una unidad DISTINTA a la
# del sistema: una copia en el mismo disco no protege contra un disco danado.
# Ejemplos: "D:/respaldos-caja" o "//servidor/respaldos"
RESPALDO_DIRECTORIO="./respaldos"
# Dias que se conservan las copias.
RESPALDO_RETENCION_DIAS="30"
# Copias que nunca se borran aunque esten vencidas.
RESPALDO_COPIAS_MINIMAS="10"

# ---- Lectura de fotos con IA ----
# La gasolina del repartidor se lee de las fotos del odometro y la factura.
# No la escriba a mano: use  npm run ia:clave
# Gemini (Google AI Studio). Si esta, se usa esta.
# GEMINI_API_KEY=
# Claude (Anthropic), alternativa.
# ANTHROPIC_API_KEY=
# Modelo opcional. Por defecto gemini-flash-latest o claude-sonnet-5.
# IA_MODELO=

# WhatsApp Business de Meta. El secreto firma los avisos del webhook; sin el,
# la aplicacion no acepta ninguno. El token de verificacion lo inventa uno y se
# escribe igual en el panel de Meta al dar de alta la direccion del webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# La direccion publica, para armar los enlaces que se mandan a los clientes.
APP_URL=

# Secreto compartido con el agente que corre en el servidor del local.
POS_AGENTE_SECRETO=
